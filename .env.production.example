# ==============================================================================
# ПРИМЕР КОНФИГУРАЦИИ ДЛЯ PRODUCTION VPS (.env.production)
# Скопируйте этот файл в .env.production и замените случайные секреты:
#   cp .env.production.example .env.production
#   chmod 600 .env.production
# Сгенерируйте стойкие ключи базой base64 через команду:
#   openssl rand -base64 32
# ==============================================================================

# Домен заведения (без https://, например: cafe-mangal.ru)
SITE_DOMAIN=example.com
DOMAIN=example.com

NODE_ENV=production

# База данных PostgreSQL
POSTGRES_DB=mangal
POSTGRES_USER=mangal
# Замените на стойкий уникальный пароль базы:
POSTGRES_PASSWORD=change_this_to_strong_vps_postgres_password_32_chars

# Секретные ключи шифрования и HMAC (Каждый ключ должен быть уникaльным base64 32 байта)
# Команда для генерации: openssl rand -base64 32
PII_KEY_RING_JSON={"activeKeyId":"vps-v1","keys":{"vps-v1":"CHANGE_ME_BASE64_KEY_32_BYTES_012345678901234567890123456="}}
PHONE_LOOKUP_HMAC_KEY=CHANGE_ME_BASE64_KEY_32_BYTES_012345678901234567890123456=
ADMIN_SESSION_HMAC_KEY=CHANGE_ME_BASE64_KEY_32_BYTES_012345678901234567890123456=
MFA_ENCRYPTION_KEY=CHANGE_ME_BASE64_KEY_32_BYTES_012345678901234567890123456=
CSRF_HMAC_KEY=CHANGE_ME_BASE64_KEY_32_BYTES_012345678901234567890123456=
INTERNAL_JOBS_TOKEN=CHANGE_ME_JOBS_TOKEN_32_CHARS_MINIMUM
STOREFRONT_REVALIDATE_SECRET=CHANGE_ME_REVALIDATE_SECRET_32_CHARS

# Первичные данные администратора для первично запуска `npm run admin:bootstrap`
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=Change_This_Admin_Password_123!

# Хранилище загрузок и медиа-файлов
STORAGE_DRIVER=local
LOCAL_MEDIA_ROOT=/app/uploads
MEDIA_PUBLIC_BASE_URL=/uploads
NEXT_PUBLIC_MEDIA_BASE_URL=/uploads

# Внутренние и внешние URL приложений
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_PLATFORM_API_URL=https://example.com/api
PLATFORM_API_URL=http://platform:8080
ADMIN_BASE_URL=https://example.com/admin

# Эквайринг (заполняется при наличии юридического договора с банком)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
