{
  "name": "mangal-commerce",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@mangal/storefront",
    "dev:storefront": "npm run dev --workspace=@mangal/storefront",
    "dev:platform": "npm run dev --workspace=@mangal/platform",
    "build": "npm run build --workspaces --if-present",
    "build:storefront": "npm run build --workspace=@mangal/storefront",
    "build:platform": "npm run build --workspace=@mangal/platform",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run tests/integration tests/contract",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "launch-check": "tsx apps/platform/src/entrypoints/launch-check.ts",
    "legal:hashes": "tsx scripts/legal-hashes.ts",
    "check:encoding": "node scripts/encoding-check.mjs",
    "admin:bootstrap": "tsx apps/platform/src/entrypoints/bootstrap-admin.ts",
    "start:all": "node scripts/start-all.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.2.8",
    "@fontsource/ibm-plex-mono": "5.2.7",
    "@fontsource/onest": "5.2.8",
    "@gsap/react": "2.1.2",
    "@hookform/resolvers": "5.2.2",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-pg": "7.7.0",
    "@prisma/client": "7.7.0",
    "clsx": "2.1.1",
    "dotenv": "17.2.2",
    "gsap": "3.13.0",
    "motion": "12.23.24",
    "next": "16.2.12",
    "otpauth": "9.4.1",
    "pg": "8.16.3",
    "pino": "9.9.4",
    "prom-client": "15.1.3",
    "qrcode": "1.5.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.62.0",
    "tailwind-merge": "3.3.1",
    "zod": "4.1.12",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@playwright/test": "1.55.0",
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/pg": "8.15.5",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.34.0",
    "eslint-config-next": "16.2.12",
    "jsdom": "26.1.0",
    "prisma": "7.7.0",
    "tailwindcss": "4.3.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
