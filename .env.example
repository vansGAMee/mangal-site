# Runtime mode
NODE_ENV=development
APP_ROLE=web
JOB_EXECUTION_MODE=loop

# Public domains - required for production launch
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_PLATFORM_API_URL=
PLATFORM_API_URL=
ADMIN_BASE_URL=
ALLOWED_STOREFRONT_ORIGINS=
TRUSTED_PROXY_POLICY=

# Public business identity - do not invent values
BUSINESS_LEGAL_NAME=
BUSINESS_INN=
BUSINESS_REGISTRATION_NUMBER=
BUSINESS_LEGAL_ADDRESS=
BUSINESS_EMAIL=
BUSINESS_PHONE=+79271061644

# PostgreSQL and connection budget
DATABASE_URL=
DIRECT_URL=
SHADOW_DATABASE_URL=
DATABASE_POOL_MAX=
DATABASE_CONNECTION_BUDGET=
WEB_MAX_INSTANCES=
WORKER_INSTANCE_COUNT=
RECONCILIATION_INSTANCE_COUNT=
RETENTION_INSTANCE_COUNT=
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_STATEMENT_TIMEOUT_MS=10000

# Separate cryptographic keys. Values are base64-encoded 32-byte secrets.
# PII_KEY_RING_JSON example shape only: {"activeKeyId":"...","keys":{"...":"base64"}}
PII_KEY_RING_JSON=
PHONE_LOOKUP_HMAC_KEY=
ADMIN_SESSION_HMAC_KEY=
MFA_ENCRYPTION_KEY=
CSRF_HMAC_KEY=
INTERNAL_JOBS_TOKEN=
STOREFRONT_REVALIDATE_SECRET=

# Payment providers - required for production launch
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_API_BASE_URL=https://api.yookassa.ru/v3
TBANK_TERMINAL_KEY=
TBANK_PASSWORD=
TBANK_API_BASE_URL=https://securepay.tinkoff.ru/v2
PAYMENT_HTTP_TIMEOUT_MS=8000

# Fiscal settings - operator and legal/accounting confirmation required
FISCAL_TAX_SYSTEM=
FISCAL_DEFAULT_VAT_CODE=
FISCAL_PAYMENT_SUBJECT=
FISCAL_PAYMENT_MODE=
FISCAL_MEASURE_PIECE=
FISCAL_MEASURE_PORTION=
FISCAL_MEASURE_KILOGRAM=
FISCAL_DELIVERY_VAT_CODE=
FISCAL_DELIVERY_PAYMENT_SUBJECT=
FISCAL_DELIVERY_PAYMENT_MODE=
FISCAL_DELIVERY_MEASURE=

# Legal configuration
PERSONAL_DATA_LEGAL_BASIS=CONTRACT
PD_DOCUMENT_VERSION=pd-v1
MARKETING_DOCUMENT_VERSION=marketing-v1
COOKIE_DOCUMENT_VERSION=cookie-v1
LEGAL_DOCS_APPROVED=false
LEGAL_PD_SHA256=
LEGAL_MARKETING_SHA256=
LEGAL_COOKIE_SHA256=
LEGAL_OFFER_SHA256=
LEGAL_TERMS_SHA256=

# Manual organisational assertions. Code cannot complete these actions.
RKN_NOTIFICATION_CONFIRMED=false
LEGAL_BASIS_REVIEWED=false
LOCAL_ACTS_APPROVED=false
RESPONSIBLE_PERSON_APPOINTED=false
PROCESSOR_CONTRACTS_CONFIRMED=false
TAX_PARAMETERS_CONFIRMED=false
DELIVERY_SETTINGS_CONFIRMED=false
MENU_VALUES_CONFIRMED=false
UNPRICED_PRODUCTS_REVIEWED=false

# Store operation. Zones/hours are deliberately absent until confirmed.
STORE_TIMEZONE=Europe/Saratov
STORE_LEAD_TIME_MINUTES=15
DELIVERY_ZONES_JSON=
OPERATING_HOURS_JSON=
CARD_PAYMENT_PROVIDER=
SBP_PAYMENT_PROVIDER=

# Analytics - no script is loaded when this is empty or consent is absent
NEXT_PUBLIC_YANDEX_METRIKA_ID=

# Retention, backup and recovery values require operator/legal approval
ORDER_PII_RETENTION_DAYS=
CONSENT_EVIDENCE_RETENTION_DAYS=
BACKUP_RPO_MINUTES=
BACKUP_RTO_MINUTES=

# Bootstrap values are one-time secrets. Remove after creating the first admin.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
