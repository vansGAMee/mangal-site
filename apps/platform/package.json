{
  "name": "@mangal/platform",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "cd ../.. && npm run prisma:generate && (npx prisma migrate resolve --applied 202608010001_initial || true) && (npx prisma migrate deploy || true) && cd apps/platform && next build",
    "db:push": "cd ../.. && npx prisma db push --accept-data-loss",
    "start": "next start --port 3001",
    "worker": "tsx src/entrypoints/worker.ts",
    "reconciliation": "tsx src/entrypoints/reconciliation.ts",
    "retention": "tsx src/entrypoints/retention.ts"
  },
  "dependencies": {
    "@mangal/catalog-seed": "1.0.0",
    "@mangal/contracts": "1.0.0",
    "@mangal/design-system": "1.0.0",
    "next": "16.2.12"
  }
}

